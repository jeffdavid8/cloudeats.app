                    "access"
                ],
                "apps.bibleBot.features.search": [
                    "use"
                ],
                "apps.bibleBot.features.bookmarks": [
                    "create",
                    "view",
                    "delete"
                ]
            }
        },
        "editor": {
            "name": "Content Editor",
            "description": "User with content creation and editing privileges",
            "permissions": {
                "inherit": [
                    "user"
                ],
                "apps.recipes.features.recipes": [
                    "view",
                    "create",
                    "update",
                    "delete"
                ],
                "apps.recipes.features.sharing": [
