                ],
                "apps.ancestry": [
                    "access"
                ],
                "apps.ancestry.features.family_tree": [
                    "view",
                    "edit"
                ],
                "apps.ancestry.features.research": [
                    "create",
                    "view"
                ]
            }
        },
        "admin": {
            "name": "Administrator",
            "description": "Full system access and user management",
            "permissions": {
                "inherit": [
                    "editor"
                ],
                "apps.admin": [
                    "access"
                ],
                "apps.admin.features.dashboard": [
                    "view"
                ],
                "apps.admin.features.users": [
                    "view",
                    "create",
                    "update",
                    "delete"
                ],
                "apps.admin.features.settings": [
                    "view",
                    "update"
                ],
                "apps.admin.features.logs": [
                    "view"
                ],
                "apps.ancestry.features.documents": [
                    "upload",
                    "view",
                    "organize"
                ],
                "system.permissions": [
                    "manage"
                ]
            }
        }
    }
