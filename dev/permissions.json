                "apps.weather.features.locations": [
                    "add",
                    "remove"
                ],
                "apps.recipes": [
                    "access"
                ],
                "apps.recipes.features.recipes": [
                    "view",
                    "create",
                    "update"
                ],
                "apps.recipes.features.voice_control": [
                    "use"
                ],
                "apps.recipes.features.images": [
                    "upload",
                    "view"
