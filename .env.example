# Environment variables for Mediabrain
# Copy this file to .env and update the values for your environment

APP_VERSION=0.5
DOMAIN=mediabrain.app
SITE_NAME=Mediabrain
SITE_DESCRIPTION=
FB_APP_ID=
SHARE_IMAGE_BUCKET_DIR=https://storage.googleapis.com/biblebot-image-share
SITE_NAME_SHORT=MB
UNDER_CONSTRUCTION=false
REQUEST_DONATIONS=false
REQUEST_DONATIONS_TIMEOUT=15000
COORDS=40.4211,-85.6538
NWS_STATION_ID=

# Database Configuration
# Update these for your database setup
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mediabrain
DB_USER=your_db_username
DB_PASS=your_secure_db_password

# Security Secrets
# Generate secure random strings for these values
# Use: php generate_env_secrets.php to generate secure values
APP_KEY=your_32_char_hex_app_key
JWT_SECRET=your_32_char_hex_jwt_secret
SESSION_SECRET=your_32_char_hex_session_secret
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_EMAIL=admin@your-domain.com

# OAuth Configuration
# Configure OAuth providers for social login
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
APPLE_CLIENT_ID=your_apple_client_id
APPLE_KEY_ID=your_apple_key_id
APPLE_TEAM_ID=your_apple_team_id

# Google Cloud Configuration
# Required for GCP Cloud Run deployment
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Mail Configuration
# Configure for your SMTP provider
MAIL_HOST=smtp.your-provider.com
MAIL_USER=your_smtp_username
MAIL_PASS=your_smtp_password

# Logging
LOG_LEVEL=debug
